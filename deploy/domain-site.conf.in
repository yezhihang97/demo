# Managed by wanxiang-domain
map $http_origin $wx_origin___ID__ {
  default reject;
  "" "";
  "https://__HOST__"     "http://127.0.0.1:4173";
  "https://__HOST__:443" "http://127.0.0.1:4173";
}

server {
  listen 443 ssl;
  server_name __HOST__;
  ssl_certificate __CERT_DIR__/fullchain.pem;
  ssl_certificate_key __CERT_DIR__/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  add_header Referrer-Policy no-referrer always;
  if ($host != "__HOST__") { return 404; }

  location ~* ^/(manage|api/merchant)(/|$) { return 404; }
  location / {
    if ($wx_origin___ID__ = reject) { return 403; }
    proxy_pass http://127.0.0.1:4173;
    proxy_http_version 1.1;
    proxy_set_header Host 127.0.0.1:4173;
    proxy_set_header Origin $wx_origin___ID__;
    proxy_set_header Connection "";
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Authorization "";
    proxy_cookie_flags ~ secure;
    proxy_redirect http://127.0.0.1:4173/ https://__HOST__/;
  }
}
